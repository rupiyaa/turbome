import bpy

# -------------------------------------------------------
# CLEAN SCENE
# -------------------------------------------------------
bpy.ops.object.select_all(action='SELECT')
bpy.ops.object.delete(use_global=False)

# -------------------------------------------------------
# CREATE MAIN SHOE RACK BODY
# -------------------------------------------------------
bpy.ops.mesh.primitive_cube_add(size=2, location=(0,0,1))
rack = bpy.context.active_object
rack.scale = (1, 0.5, 1.5)   # Width, Depth, Height
rack.name = "ShoeRack"

# -------------------------------------------------------
# CREATE SHELVES (3 total)
# -------------------------------------------------------
shelves = []
for i, z in enumerate([0.2, 0.8, 1.2]):  # z-heights
    bpy.ops.mesh.primitive_cube_add(size=2, location=(0,0,z))
    shelf = bpy.context.active_object
    shelf.scale = (0.95, 0.48, 0.02)
    shelf.name = f"Shelf_{i+1}"
    shelves.append(shelf)

# -------------------------------------------------------
# CREATE PUSH-PULL FLAP ("PLACE ITEMS HERE")
# -------------------------------------------------------
bpy.ops.mesh.primitive_cube_add(size=1, location=(0,0,1.55))
flap = bpy.context.active_object
flap.scale = (0.9, 0.05, 0.2)
flap.name = "Flap"

# Add text label
bpy.ops.object.text_add(location=(0,0.3,1.55))
text = bpy.context.active_object
text.data.body = "PLACE ITEMS HERE"
text.rotation_euler[0] = 1.57
text.scale = (0.3,0.3,0.3)

# -------------------------------------------------------
# CREATE DOOR
# -------------------------------------------------------
bpy.ops.mesh.primitive_cube_add(size=2, location=(1.01,0,1))
door = bpy.context.active_object
door.scale = (0.05, 0.5, 1.5)
door.name = "Door"

# -------------------------------------------------------
# CREATE HOOKS (simple cylinders inside door)
# -------------------------------------------------------
hooks = []
for i, z in enumerate([0.5, 1.0, 1.5]):
    bpy.ops.mesh.primitive_cylinder_add(radius=0.02, depth=0.2, location=(1.05, -0.3, z))
    hook = bpy.context.active_object
    hook.rotation_euler[1] = 1.57
    hook.name = f"Hook_{i+1}"
    hooks.append(hook)

# -------------------------------------------------------
# ANIMATION
# -------------------------------------------------------
scene = bpy.context.scene
scene.frame_start = 1
scene.frame_end = 120

# Animate flap open (frames 1–30)
flap.rotation_euler[1] = 0
flap.keyframe_insert(data_path="rotation_euler", frame=1)
flap.rotation_euler[1] = -1.0
flap.keyframe_insert(data_path="rotation_euler", frame=30)

# Animate flap close (frames 30–60)
flap.rotation_euler[1] = 0
flap.keyframe_insert(data_path="rotation_euler", frame=60)

# Animate door open (frames 60–90)
door.rotation_euler[2] = 0
door.keyframe_insert(data_path="rotation_euler", frame=60)
door.rotation_euler[2] = -1.57
door.keyframe_insert(data_path="rotation_euler", frame=90)

# Animate door close (frames 90–120)
door.rotation_euler[2] = 0
door.keyframe_insert(data_path="rotation_euler", frame=120)

# -------------------------------------------------------
# RENDER SETTINGS
# -------------------------------------------------------
scene.render.engine = 'CYCLES'
scene.render.image_settings.file_format = 'FFMPEG'
scene.render.ffmpeg.format = 'MPEG4'
scene.render.filepath = "//shoe_rack_animation.mp4"

print("✅ Shoe rack animation ready. Run Render > Render Animation to export.")
